{
  "name": "vibehabit-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@vibehabit/server",
    "dev:web": "npm run dev --workspace=@vibehabit/web",
    "typecheck": "npm run --workspaces --if-present typecheck && tsc --noEmit -p tests/tsconfig.json",
    "lint": "npm run --workspaces --if-present lint",
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:unit": "npm run --workspace=@vibehabit/shared test:unit",
    "test:integration": "npm run --workspace=@vibehabit/server test:integration"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  }
}
